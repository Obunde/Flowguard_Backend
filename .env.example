# Copy to .env. Only app/core/config.py reads these.

APP_NAME=flowgard
ENVIRONMENT=development
DEBUG=true

# TCP: postgresql+psycopg://user:password@host:5432/flowgard
# Local socket + peer auth: postgresql+psycopg://user@/flowgard
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/flowgard
# Separate DB for the test suite.
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/flowgard_test

# docker compose: password for the bundled Postgres container (required)
POSTGRES_PASSWORD=

JWT_SECRET_KEY=change-me-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_RESET_TOKEN_EXPIRE_MINUTES=30

# Platform-admin bootstrap. PLATFORM_ADMIN_PASSWORD is required (no default).
PLATFORM_ADMIN_EMAIL=platform.admin@flow.com
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_FULL_NAME=Platform Administrator

# Onboarding-credential email. Empty SMTP_HOST disables sending (routes 503).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@flowgard.local
SMTP_USE_TLS=true

CORS_ALLOW_ORIGINS=http://localhost:3000

WEATHER_API_BASE_URL=https://api.open-meteo.com/v1
SIMULATOR_INTERVAL_SECONDS=5

# Refresh sessions and idempotent demo bootstrap
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
SEED_ADMIN_EMAIL=admin@flowgard.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FULL_NAME=Flowgard Administrator
SEED_PLANNER_EMAIL=planner@flowgard.com
SEED_PLANNER_PASSWORD=
SEED_TECHNICIAN_EMAIL=technician@flowgard.com
SEED_TECHNICIAN_PASSWORD=
SEED_VIEWER_EMAIL=viewer@flowgard.com
SEED_VIEWER_PASSWORD=

# Optional email delivery; leave SMTP_HOST empty to expose digest as unavailable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
